DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/track_tdr?sslmode=require&pgbouncer=true"

# Optional. Useful for Prisma migrate dev / advanced migration workflows.
# SHADOW_DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/track_tdr_shadow?sslmode=require"

REDIS_URL="redis://localhost:6379"
# Use your machine LAN IP when testing from mobile, e.g. http://192.168.1.10:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Keep false for HTTP access via LAN IP during local/mobile testing
COOKIE_SECURE="false"

# Mobile app (tdr-mobile) uses Bearer tokens against this URL
# EXPO_PUBLIC_API_URL on the phone should match your machine LAN IP

JWT_ACCESS_SECRET="replace-with-at-least-32-characters-access"
JWT_REFRESH_SECRET="replace-with-at-least-32-characters-refresh"

SEED_ADMIN_EMAIL="admin@track-tdr.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
